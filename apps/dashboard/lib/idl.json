  "types": [
    {
      "name": "ActionIntent",
      "docs": [
        "ActionIntent — Represents a single proposed value-moving action.",
        "",
        "PDA: [\"intent\", id]",
        "Lifecycle: PROPOSED → PENDING_APPROVAL → APPROVED_READY → SETTLED",
        "→ DENIED → REFUNDED",
        "→ EXPIRED (via sweep)",
        "",
        "Funds are escrowed in the vault ATA on creation.",
        "Settlement transfers from vault to recipient.",
        "Refund returns from vault to requester."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "id",
            "docs": [
              "Client-generated unique identifier (UUID bytes)"
            ],
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "agent",
            "docs": [
              "The autonomous agent proposing this action"
            ],
            "type": "pubkey"
          },
          {
            "name": "requester",
            "docs": [
              "The wallet funding this action (may differ from agent)"
            ],
            "type": "pubkey"
          },
          {
            "name": "recipient",
            "docs": [
              "The destination wallet for settlement"
            ],
            "type": "pubkey"
          },
          {
            "name": "mint",
            "docs": [
              "The SPL token mint (must match GuardConfig.treasury_mint)"
            ],
            "type": "pubkey"
          },
          {
            "name": "amount",
            "docs": [
              "Amount in token base units"
            ],
            "type": "u64"
          },
          {
            "name": "action_type",
            "docs": [
              "Action classification: 0=api_payment, 1=reward, 2=treasury"
            ],
            "type": "u8"
          },
          {
            "name": "status",
            "docs": [
              "Current lifecycle status (see constants::status)"
            ],
            "type": "u8"
          },
          {
            "name": "receipt_hash",
            "docs": [
              "SHA-256 hash of the offchain policy receipt"
            ],
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "policy_verdict",
            "docs": [
              "Policy engine verdict at creation time"
            ],
            "type": "u8"
          },
          {
            "name": "created_at",
            "docs": [
              "Unix timestamp of intent creation"
            ],
            "type": "i64"
          },
          {
            "name": "expires_at",
            "docs": [
              "Unix timestamp after which the intent can be swept"
            ],
            "type": "i64"
          },
          {
            "name": "settled_at",
            "docs": [
              "Unix timestamp of settlement (0 if not yet settled)"
            ],
            "type": "i64"
          },
          {
            "name": "bump",
            "docs": [
              "PDA bump seed"
            ],
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "ApprovalRecord",
      "docs": [
        "ApprovalRecord — Records a human approval decision for an intent.",
        "",
        "PDA: [\"approval\", intent_id]",
        "Created when `approve_action` is called. One approval per intent.",
        "Can be extended to N-of-M quorum in Phase 5."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "intent",
            "docs": [
              "The ActionIntent account this approval references"
            ],
            "type": "pubkey"
          },
          {
            "name": "intent_id",
            "docs": [
              "The intent ID for reverse lookup"
            ],
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "approver",
            "docs": [
              "The pubkey that signed the approval"
            ],
            "type": "pubkey"
          },
          {
            "name": "approved_at",
            "docs": [
              "Unix timestamp of approval"
            ],
            "type": "i64"
          },
          {
            "name": "bump",
            "docs": [
              "PDA bump seed"
            ],
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "BudgetAccount",
      "docs": [
        "BudgetAccount — Per-agent daily spend tracking.",
        "",
        "PDA: [\"budget\", owner, scope]",
        "Supports lazy reset: when `create_action_intent` checks the budget,",
        "it resets `spent_today` if 24h+ have elapsed since `last_reset_unix`.",
        "No cron required."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "owner",
            "docs": [
              "The agent/wallet this budget applies to"
            ],
            "type": "pubkey"
          },
          {
            "name": "guard_config",
            "docs": [
              "Backlink to the parent GuardConfig for validation"
            ],
            "type": "pubkey"
          },
          {
            "name": "scope",
            "docs": [
              "Scope discriminator (e.g. hash of department/team/project)"
            ],
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "daily_cap",
            "docs": [
              "Maximum daily spend in token base units"
            ],
            "type": "u64"
          },
          {
            "name": "spent_today",
            "docs": [
              "Amount spent in the current day window"
            ],
            "type": "u64"
          },
          {
            "name": "last_reset_unix",
            "docs": [
              "Unix timestamp of the last budget reset"
            ],
            "type": "i64"
          },
          {
            "name": "lifetime_spent",
            "docs": [
              "Lifetime cumulative spend (analytics)"
            ],
            "type": "u64"
          },
          {
            "name": "bump",
            "docs": [
              "PDA bump seed"
            ],
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "GuardConfig",
      "docs": [
        "GuardConfig — Singleton program configuration.",
        "",
        "PDA: [\"guard_config\"]",
        "Created once via `initialize_guard`. Stores administrative keys",
        "and cumulative metrics for the dashboard."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "authority",
            "docs": [
              "Authority that can pause/unpause and update config"
            ],
            "type": "pubkey"
          },
          {
            "name": "treasury_mint",
            "docs": [
              "SPL token mint used for all settlements (e.g. mock USDC)"
            ],
            "type": "pubkey"
          },
          {
            "name": "receipt_signer",
            "docs": [
              "Key used to verify offchain receipt signatures (Ed25519)"
            ],
            "type": "pubkey"
          },
          {
            "name": "approval_signer",
            "docs": [
              "Key authorized to approve/deny pending actions"
            ],
            "type": "pubkey"
          },
          {
            "name": "default_daily_cap",
            "docs": [
              "Default daily spend cap for new budget accounts"
            ],
            "type": "u64"
          },
          {
            "name": "total_value_guarded",
            "docs": [
              "Cumulative value of all settled actions (dashboard metric)"
            ],
            "type": "u64"
          },
          {
            "name": "total_actions",
            "docs": [
              "Total number of intents created"
            ],
            "type": "u64"
          },
          {
            "name": "total_denied",
            "docs": [
              "Total number of denied actions"
            ],
            "type": "u64"
          },
          {
            "name": "paused",
            "docs": [
              "Emergency pause — blocks all new intents and settlements"
            ],
            "type": "bool"
          },
          {
            "name": "bump",
            "docs": [
              "PDA bump seed"
            ],
            "type": "u8"
          }
        ]
      }
    },
